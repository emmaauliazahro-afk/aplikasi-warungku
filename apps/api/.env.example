# Database
# Local PostgreSQL
# DATABASE_URL="postgresql://warung:warung123@localhost:5432/warung_db?schema=public"

# Supabase PostgreSQL
# Pooler Connection (untuk aplikasi - recommended)
DATABASE_URL="postgresql://your-user:your-password@your-region.pooler.supabase.com:6543/postgres"

# Direct Connection (untuk migrasi Prisma - gunakan dengan: DATABASE_URL=<direct> npx prisma migrate)
# DATABASE_URL="postgresql://your-user:your-password@your-region.pooler.supabase.com:5432/postgres"

# Catatan: Jika password mengandung karakter khusus (#, @, dll), encode dengan URL encoding
# Contoh: password "test#123" menjadi "test%23123"

# Server
PORT=5000

# Allowed CORS origin(s), comma-separated for production/preview domains.
WEB_ORIGIN=http://localhost:3000

# Use "none" when frontend and API are on different HTTPS domains.
COOKIE_SAME_SITE=lax

# JWT
JWT_SECRET=your-secret-key-here
