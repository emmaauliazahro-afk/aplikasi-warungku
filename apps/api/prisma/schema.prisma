// Prisma schema for Aplikasi Digitalisasi Warung Kelontong
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("users")
}

enum UserRole {
  OWNER
  CASHIER
}

// ============================================
// PRODUCT & INVENTORY
// ============================================
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  sku           String?  @unique
  name          String
  purchasePrice Decimal  @default(0) @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  stock         Int      @default(0)
  minStock      Int      @default(5) @map("min_stock")
  unit          String   @default("pcs")
  categoryId    Int?     @map("category_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactionItems TransactionItem[]
  stockMovements   StockMovement[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

// Track every stock change for audit/history
model StockMovement {
  id           Int               @id @default(autoincrement())
  productId    Int               @map("product_id")
  type         StockMovementType
  quantity     Int // positive = in, negative = out
  stockBefore  Int               @map("stock_before")
  stockAfter   Int               @map("stock_after")
  note         String?
  referenceId  Int?              @map("reference_id") // e.g. transaction id
  createdAt    DateTime          @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stock_movements")
}

enum StockMovementType {
  PURCHASE // stok masuk (beli)
  SALE // stok keluar (jual)
  ADJUSTMENT // koreksi manual (opname)
  RETURN // retur
}

// ============================================
// CUSTOMER
// ============================================
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  debts        Debt[]

  @@index([name])
  @@map("customers")
}

// ============================================
// TRANSACTION (POS)
// ============================================
model Transaction {
  id                Int               @id @default(autoincrement())
  transactionNumber String            @unique @map("transaction_number")
  customerId        Int?              @map("customer_id")
  userId            Int?              @map("user_id")
  subtotal          Decimal           @default(0) @db.Decimal(12, 2)
  discount          Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  changeAmount      Decimal           @default(0) @map("change_amount") @db.Decimal(12, 2)
  paymentMethod     PaymentMethod     @default(CASH) @map("payment_method")
  status            TransactionStatus @default(COMPLETED)
  note              String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    TransactionItem[]
  debt     Debt?

  @@index([customerId])
  @@index([createdAt])
  @@map("transactions")
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBT // bon/hutang
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
}

model TransactionItem {
  id            Int     @id @default(autoincrement())
  transactionId Int     @map("transaction_id")
  productId     Int?    @map("product_id")
  productName   String  @map("product_name") // snapshot in case product deleted
  quantity      Int
  price         Decimal @db.Decimal(12, 2) // selling price at time of sale
  costPrice     Decimal @default(0) @map("cost_price") @db.Decimal(12, 2) // purchase price snapshot for profit calc
  subtotal      Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

// ============================================
// DEBT (Hutang/Piutang)
// ============================================
model Debt {
  id            Int        @id @default(autoincrement())
  customerId    Int        @map("customer_id")
  transactionId Int?       @unique @map("transaction_id")
  amount        Decimal    @db.Decimal(12, 2)
  paidAmount    Decimal    @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remaining     Decimal    @db.Decimal(12, 2)
  status        DebtStatus @default(UNPAID)
  dueDate       DateTime?  @map("due_date")
  note          String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transaction Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  payments    DebtPayment[]

  @@index([customerId])
  @@index([status])
  @@map("debts")
}

enum DebtStatus {
  UNPAID
  PARTIAL
  PAID
}

model DebtPayment {
  id        Int      @id @default(autoincrement())
  debtId    Int      @map("debt_id")
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_payments")
}
