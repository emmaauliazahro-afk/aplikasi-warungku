{
  "name": "aplikasi-warung",
  "version": "1.0.0",
  "description": "Aplikasi Digitalisasi Warung Kelontong - Open Source POS System",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "db:up": "sudo docker compose up -d",
    "db:down": "sudo docker compose down",
    "db:migrate": "cd apps/api && npm run prisma:migrate",
    "db:seed": "cd apps/api && npm run prisma:seed",
    "db:studio": "cd apps/api && npm run prisma:studio",
    "test": "cd apps/api && npm run test"
  },
  "keywords": ["pos", "warung", "umkm", "point-of-sale", "inventory"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
