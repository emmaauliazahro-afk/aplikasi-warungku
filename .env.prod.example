# ====== Konfigurasi Deployment Produksi (docker-compose.prod.yml) ======
# Salin file ini ke `.env` di root proyek lalu sesuaikan nilainya.
#   cp .env.prod.example .env
#
# =====================================================================
# PERINGATAN KEAMANAN: Ganti semua nilai default sebelum deploy!
# Secret lemah akan ditolak saat API start di production.
# =====================================================================

# --- Database ---
POSTGRES_USER=warung
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=warung_db

# --- Backend API ---
# WAJIB diganti dengan string acak yang panjang & rahasia.
# Minimal 32 karakter, direkomendasikan 64 char hex.
# Contoh generate: `openssl rand -hex 32`
# Nilai lemah/short/default akan di-reject saat API start di production.
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
# Origin frontend yang diizinkan CORS (URL publik web Anda).
# PENTING: Di production, JANGAN gunakan http://, harus https://
# (akan di-warning saat start jika WEB_ORIGIN masih http://)
WEB_ORIGIN=http://localhost:3000

# --- Frontend ---
# URL API yang diakses BROWSER (di-inline saat build). Untuk akses LAN/publik,
# gunakan IP/domain server, mis. http://192.168.1.10:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# --- Catatan Pasca-Deploy ---
# Setelah `docker compose up` dan container berjalan, SEGERA ganti password
# owner default (username: owner, password: password123) sebelum dipakai
# di production. Akun default hanya untuk bootstrap awal.
